# Secrets
.env

# Virtualenv
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime state: rebuilt by running the agent. The directory and runbooks are
# committed; the databases the agent writes are not.
data/*.db
data/checkpoints.db

# Eval output. The working directory is ignored, but the two artefacts a reviewer
# needs are not: the demo video and the evaluation results are part of the submission.
out/*
!out/video/
out/video/*
!out/video/switchboard-demo.mp4
!out/eval-results.json

# IDE
.idea/
.vscode/

# Test scratch: rebuilt by tests/conftest.py on every run
data-test/

# Eval scratch: isolated DATA_DIR so an eval run and a live call never share a database
data-eval/
data/*.db-shm
data/*.db-wal
