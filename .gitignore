# Secrets
.env

# Virtualenv
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime state: rebuilt by running the agent. The directory and runbooks are
# committed; the databases the agent writes are not.
data/*.db
data/checkpoints.db

# Eval output
out/

# IDE
.idea/
.vscode/

# Test scratch: rebuilt by tests/conftest.py on every run
data-test/

# Eval scratch: isolated DATA_DIR so an eval run and a live call never share a database
data-eval/
