# --- In-call agents (latency matters; someone is holding a phone) ---
OPENAI_API_KEY=sk-...
CALL_MODEL=gpt-4.1-mini

# --- Post-call reviewer: Nebius Token Factory ---
# Deliberately a different provider and model family from the in-call agents. The
# reviewer judges whether those agents did their job; sharing a model makes that a
# self-assessment. Without this the reviewer falls back to OpenAI and every verdict
# is stamped independent=false so the number is never mistaken for something it isn't.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
REVIEW_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- ElevenLabs Conversational AI (voice front end) ---
ELEVENLABS_API_KEY=
# Shared secret ElevenLabs sends on every tool webhook. Without it the server refuses
# writes: an open ticket-creation endpoint is a spam vector before it is anything else.
WEBHOOK_SECRET=

# --- Optional behaviour overrides (see switchboard/config.py for why each exists) ---
# KB_MIN_SCORE=48
# MAX_VERIFY_ATTEMPTS=2
# ITSM_BACKEND=up          # set to 'down' to exercise the degraded ticket path
